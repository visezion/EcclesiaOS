APP_NAME="KingdomHub"
APP_SUBTITLE="Enterprise Church Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DOWNLOAD_URL=https://github.com/visezion/EcclesiaOS/archive/refs/heads/main.zip
APP_DOCUMENTATION_URL=https://github.com/visezion/EcclesiaOS/blob/main/docs/DEVELOPER_HUB.md
UPDATER_ENABLED=true
UPDATER_INSTALL_ENABLED=false
UPDATE_REPOSITORY=visezion/EcclesiaOS
UPDATE_CHANNEL=stable
UPDATE_CHECK_INTERVAL=21600
UPDATE_REQUIRE_IMMUTABLE=true
UPDATE_MANIFEST_ASSET=update-manifest.json
UPDATE_MAX_DOWNLOAD_BYTES=524288000
UPDATE_MAX_EXPANDED_BYTES=1073741824
UPDATE_REQUEST_TIMEOUT=30
GITHUB_UPDATE_TOKEN=

# Required only for Linux one-click installation.
UPDATER_CURRENT_LINK=
UPDATER_RELEASES_PATH=
UPDATER_SHARED_PATH=
UPDATER_BACKUP_STORAGE=true
UPDATER_BACKUP_RETENTION=5
UPDATER_HEALTH_URL="${APP_URL}/up"
UPDATER_PHP_BINARY=php
UPDATER_MYSQLDUMP_BINARY=mysqldump
UPDATER_PG_DUMP_BINARY=pg_dump

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Use true when the application is served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CHURCH_NAME="Kingdom Life Global Church"
CHURCH_ADDRESS="Lagos, Nigeria"
CHURCH_TIMEZONE=UTC
CHURCH_CURRENCY=USD
CHURCH_CONTACT_EMAIL=hello@example.org
CHURCH_CONTACT_PHONE="+1 555 0100"
