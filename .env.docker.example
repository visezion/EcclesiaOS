COMPOSE_PROJECT_NAME=ecclesiaos
ECCLESIAOS_VERSION=1.0.0
VCS_REF=local

APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
APP_NAME="KingdomHub"
APP_SUBTITLE="Enterprise Church Management System"
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=http://localhost:8080
ASSET_URL=http://localhost:8080
CLOUDFLARE_INSIGHTS_ENABLED=false
TRUSTED_PROXIES=*
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

APP_DOWNLOAD_URL=https://github.com/visezion/EcclesiaOS/releases/latest
APP_DOCUMENTATION_URL=https://github.com/visezion/EcclesiaOS/blob/main/docs/DEVELOPER_HUB.md

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ecclesiaos
DB_USERNAME=ecclesiaos
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_DATABASE=ecclesiaos
MYSQL_USER=ecclesiaos
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=public

LOG_CHANNEL=stderr
LOG_LEVEL=warning
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

UPDATER_ENABLED=true
UPDATER_INSTALL_ENABLED=true
UPDATE_REPOSITORY=visezion/EcclesiaOS
UPDATE_CHANNEL=stable
UPDATE_CHECK_INTERVAL=21600
UPDATE_MANIFEST_ASSET=update-manifest.json
UPDATER_MANAGED_ROOT=/var/www/html/.managed
UPDATER_RELEASES_PATH=/var/www/html/.managed/releases
UPDATER_SHARED_PATH=/var/www/html/.managed/shared
UPDATER_CURRENT_LINK=/var/www/html/.managed/current
UPDATER_HEALTH_URL=http://web/up
UPDATER_RELOAD_COMMAND_JSON='["/bin/true"]'
REDIS_QUEUE_RETRY_AFTER=3600
GITHUB_UPDATE_TOKEN=

CHURCH_NAME="Kingdom Life Global Church"
CHURCH_ADDRESS="Lagos, Nigeria"
CHURCH_TIMEZONE=UTC
CHURCH_CURRENCY=USD
CHURCH_CONTACT_EMAIL=hello@example.org
CHURCH_CONTACT_PHONE="+1 555 0100"

# Optional unattended bootstrap. Leave blank to use the branded installer or
# the interactive prompts in docker/setup.sh and docker/setup.ps1.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
